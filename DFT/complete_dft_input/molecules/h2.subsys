 &SUBSYS
     &CELL
        CELL_FILE_FORMAT CIF
        CELL_FILE_NAME h2.cif
     &END CELL

     &TOPOLOGY
       COORD_FILE_FORMAT CIF
       COORD_FILE_NAME h2.cif
     &END TOPOLOGY

     &KIND Mg
      ELEMENT      Mg
      BASIS_SET    DZVP-MOLOPT-SR-GTH-q2
      POTENTIAL    GTH-PBE-q2
    &END KIND

    &KIND H
